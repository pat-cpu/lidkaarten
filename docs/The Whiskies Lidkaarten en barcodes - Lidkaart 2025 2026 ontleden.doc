<h3 data-section-id="v69un2" data-start="7137" data-end="7148">Waarom?</h3>
<ul data-start="7149" data-end="7255">
<li data-section-id="o1bycj" data-start="7149" data-end="7170">
<p data-start="7151" data-end="7170">10 kaarten per blad</p>
</li>
<li data-section-id="16c306w" data-start="7171" data-end="7191">
<p data-start="7173" data-end="7191">weinig verspilling</p>
</li>
<li data-section-id="de452q" data-start="7192" data-end="7208">
<p data-start="7194" data-end="7208">snijlijnen aan</p>
</li>
<li data-section-id="1sdhr89" data-start="7209" data-end="7255">
<p data-start="7211" data-end="7255">geen lelijke debug-kaders op de finale print</p>
</li>
</ul>
<hr data-start="7257" data-end="7260">
