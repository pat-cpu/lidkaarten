<h3 data-section-id="ssr5u2" data-start="2611" data-end="2624">Betekenis</h3>
<ul data-start="2625" data-end="2683">
<li data-section-id="e0w306" data-start="2625" data-end="2653">
<p data-start="2627" data-end="2653">negatief = meer naar links</p>
